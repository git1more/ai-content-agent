# ============ 密钥与环境 ============
.env
.env.*
!.env.example

# ============ Python ============
__pycache__/
*.pyc
.venv/
venv/

# ============ 临时目录 ============
_tmp/

# ============ 第三方二进制 ============
# ffmpeg 79 MB，由 scripts/get_ffmpeg.py 现场下载
tools/ffmpeg/

# ============ 原始资产（859 MB，本地保留，不入库）============
# 仓库只放 docs/showcase/ 下的压缩展示件；
# 所有量化结论仍以本地 assets/ 的原文件为准，README 里写明了这一点。
assets/manju/**/*.png
assets/manju/**/*.mp4
# 音轨中间产物：voice_full/ambience/mix/mix_norm 各 8.4 MB，成片里已混好
# 注意：gitignore 不支持行尾注释，写在行尾会让整行变成匹配不到的模式
assets/manju/**/*.wav
assets/ecom_set/**/*.png
assets/p0_testset/**/*.png
assets/bench/**/*.png
assets/**/_raw/
# 质检抽帧（视频抽出来的帧，可由成片随时重抽）
assets/**/_vlmframes/

# 例外：两集成片是核心交付物，必须入库（GitHub 单文件上限 100 MB，实际各 17–24 MB）
!assets/manju/ch03/versions/v2/*.mp4
!assets/manju/ch04/versions/v4/*.mp4

# 成本台账 / 清单 / 评分是核心证据，体积很小，不排除

# ============ 单图运行的中间产物 ============
# final.png 与 meta.json 是证据（参数 + 成品），raw*.png 是未裁切的中间图
runs/**/raw*.png
runs/_superseded/

# ============ 系统 ============
.DS_Store
Thumbs.db
