# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#
# 本项目使用阿里云百炼（DashScope）北京区。
# API Key 申请：https://bailian.console.aliyun.com/  → API-KEY 管理

PROVIDER_API_KEY=REPLACE_WITH_YOUR_DASHSCOPE_KEY

# OpenAI 兼容模式端点。地域不同域名不同（北京 / 新加坡）。
PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 生成与编辑共用同一个模型 ID（qwen-image-3.0 没有独立 edit 端点）
PROVIDER_MODEL_GEN=qwen-image-3.0
PROVIDER_MODEL_EDIT=qwen-image-3.0

# 单张图预算上限（美元），超预算的调用会被拒绝
BUDGET_PER_IMAGE_USD=0.03
